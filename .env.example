# ============================================================================
# BERES MONOREPO - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Salin file ini ke .env untuk pengembangan lokal. JANGAN commit file .env asli!
# ============================================================================

# --- 1. SUPABASE (D-15: Full Supabase Backend) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-local-or-project-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-server-only

# --- 2. WEB ADMIN (Next.js - web/admin) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-or-project-anon-key
NEXT_PUBLIC_MAP_PROVIDER=osm
NEXT_PUBLIC_APPEAL_EMAIL=support@beres.id

# --- 3. CUSTOM SMTP FOR EMAIL OTP (D-09: Resend) ---
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_your_resend_api_key
SMTP_SENDER_EMAIL=no-reply@beres.id
SMTP_SENDER_NAME=Beres Indonesia

# --- 4. FIREBASE CLOUD MESSAGING (FR-040: Push Notification) ---
FCM_PROJECT_ID=beres-app-id

# --- 5. PHASE 2 HOOKS (DILARANG DIAKTIFKAN DI MVP - D-02) ---
# DOKU_CLIENT_ID=
# DOKU_SECRET_KEY=
# GOOGLE_MAPS_API_KEY=
