.env.*
!.env.example
*.pem
*.key
*.jks
*.p8
*.p12
*.mobileprovision
google-services.json
GoogleService-Info.plist

# macOS / OS
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# IDEs & Editors
.vscode/
.idea/
*.iml
*.swp
*.swo

# Flutter / Dart (mobile/shared, mobile/user, mobile/tukang)
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
coverage/
**/ios/Pods/
**/ios/.symlinks/
**/android/.gradle/
**/android/local.properties
**/android/key.properties
**/Generated.xcconfig
**/flutter_export_environment.sh

# Next.js / Node (web/admin & tests)
node_modules/
.next/
out/
dist/
.vercel/
*.tsbuildinfo
next-env.d.ts
playwright-report/
